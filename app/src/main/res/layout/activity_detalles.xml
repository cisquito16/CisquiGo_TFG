<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/ivDetalleImagen"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:scaleType="centerCrop" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333" />

            <TextView
                android:id="@+id/tvDetalleCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9C27B0"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDetalleRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FF9800"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvDetalleDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#666" />

            <Button
                android:id="@+id/btnPedirCita"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="PEDIR CITA"
                android:backgroundTint="#FF5722"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="VOLVER"
                android:backgroundTint="#4A2C5D"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>